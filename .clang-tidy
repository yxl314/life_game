---
# 只检查本项目 src/ 下的源码和头文件。正则同时允许 ./ 和 ../ 前缀，
# portability-avoid-pragma-once：项目统一用 #pragma once，不为这条风格
#   检查迁移 90 个头文件；template-virtual-member-function 命中的是 Qt 模板头。
Checks: '-*,clang-analyzer-*,bugprone-*,cert-*,portability-*,performance-*,-bugprone-easily-swappable-parameters,-performance-enum-size,-portability-avoid-pragma-once,-portability-template-virtual-member-function'
HeaderFilterRegex: '^(\./|\.\./)*src/([^.]|\.[^./])'
SystemHeaders: false
FormatStyle: file
